class Solution {
public:
    bool rotateString(string s, string goal) {
        
        int len = s.length();
        for(int i = 0 ; i < len ; i++)
        {
            s = s + s[i];
            string substring = s.substr(i+1,len+1);
            if(substring == goal)
            {
                return true;
            }
        }
        return false;
    }
};
